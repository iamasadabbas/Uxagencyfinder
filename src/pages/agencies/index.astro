---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AuthorReviewLine from '../../components/AuthorReviewLine.astro';
import Icon from '../../components/Icon.astro';
import Avatar from '../../components/Avatar.astro';
import { getIndustries, getAgency, absolute } from '../../lib/data';
import { themeFor } from '../../lib/visuals';

const industries = getIndustries();
const jsonLd = [{
  '@type': 'CollectionPage', name: 'UX design agencies by industry', url: absolute('/agencies/'),
  mainEntity: { '@type': 'ItemList', itemListElement: industries.map((i, n) => ({ '@type': 'ListItem', position: n + 1, name: i.h1, url: absolute(i.route) })) },
}];
---

<BaseLayout title="UX Design Agencies by Industry" description="Browse curated UX design agency lists by industry: healthcare, fintech, ecommerce, logistics, real estate, education, robotics and AI & ML." jsonLd={jsonLd}>
  <header class="page-hero">
    <div class="container">
      <Breadcrumbs items={[{ name: 'Industries', href: '/agencies/' }]} />
      <p class="eyebrow">{industries.length} industries</p>
      <h1>UX design agencies by industry</h1>
      <p class="lead">Pick the market you're building for. Each list only includes agencies with named work in that industry, in an editorial order with the reasoning shown.</p>
      <AuthorReviewLine />
    </div>
  </header>

  <div class="container section">
    <div class="list">
      {industries.map((i) => {
        const t = themeFor(i.id);
        return (
          <article class="row card-hover reveal" style={`--ic:${t.color};--is:${t.soft}`}>
            <div class="row-main">
              <div class="row-head">
                <span class="ic"><Icon name={i.id} size={24} /></span>
                <div>
                  <h2><a href={i.route}>{i.h1}</a></h2>
                  <p class="cnt">{i.placements.length} agencies</p>
                </div>
              </div>
              <p class="muted">{i.intro}</p>
              <ul class="tag-list">{i.contexts.map((c) => <li class="tag">{c}</li>)}</ul>
            </div>
            <div class="side">
              <p class="side-title">Top picks</p>
              <ol>
                {i.placements.slice(0, 3).map((p) => {
                  const a = getAgency(p.agency_id)!;
                  return <li><span class:list={['pos', { 'pos-1': p.position === 1 }]}>{p.position}</span><Avatar name={a.name} size={28} /><span class="nm">{a.name}</span></li>;
                })}
              </ol>
              <a class="btn btn-primary btn-small" href={i.route}>View all {i.placements.length} <Icon name="arrow" size={14} /></a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style>
  .list { display: grid; gap: 1.25rem; }
  .row { display: grid; grid-template-columns: 1fr 280px; gap: 2rem; background: #fff; border: 1px solid var(--c-border); border-radius: var(--radius-lg); padding: 1.75rem; box-shadow: var(--shadow-xs); }
  .row-head { display: flex; gap: 1rem; align-items: center; margin-bottom: 0.9rem; }
  .ic { display: grid; place-items: center; width: 3.2rem; height: 3.2rem; border-radius: 16px; background: var(--is); color: var(--ic); flex: none; }
  h2 { font-size: 1.4rem; margin: 0; }
  h2 a { color: var(--c-text); text-decoration: none; }
  h2 a:hover { color: var(--c-accent); }
  .cnt { margin: 0.1rem 0 0; font-size: 0.85rem; color: var(--ic); font-weight: 600; }
  .side { background: var(--c-bg-soft); border: 1px solid var(--c-border); border-radius: var(--radius); padding: 1.15rem; display: flex; flex-direction: column; }
  .side-title { font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--c-muted); margin-bottom: 0.6rem; }
  .side ol { list-style: none; margin: 0 0 1rem; padding: 0; display: grid; gap: 0.55rem; }
  .side li { display: flex; align-items: center; gap: 0.55rem; }
  .side .pos { min-width: 1.6rem; height: 1.6rem; font-size: 0.75rem; border-radius: 7px; }
  .nm { font-weight: 600; color: var(--c-text); font-size: 0.92rem; }
  .side .btn { margin-top: auto; align-self: flex-start; }
  @media (max-width: 820px) { .row { grid-template-columns: 1fr; } }
</style>
