---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AuthorReviewLine from '../../components/AuthorReviewLine.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import AgencyAssessment from '../../components/AgencyAssessment.astro';
import FAQ from '../../components/FAQ.astro';
import { site, getIndustries, getIndustry, getAgency, getSource, agencyUrl, absolute, guides } from '../../lib/data';
import type { Industry } from '../../lib/data';

export function getStaticPaths() {
  return getIndustries().map((industry) => ({ params: { industry: industry.slug }, props: { id: industry.id } }));
}

const industry = getIndustry(Astro.props.id) as Industry;
const related = industry.related.map((id) => getIndustry(id)).filter((x): x is Industry => !!x);
const sourceIds = [...new Set(industry.placements.flatMap((p) => p.source_ids))];
const sources = sourceIds.map((id) => getSource(id)!).sort((a, b) => a.id.localeCompare(b.id));

const faqs = [
  { q: `What counts as ${industry.name.toLowerCase()} experience here?`, a: `A named project in this niche with a public account of the agency's contribution. ${industry.selection_emphasis}` },
  { q: 'Is the agency at position 1 the best choice for every project?', a: 'No. Positions are the editorial order for this list as a whole. A narrower brief may be better served by an agency further down. Read the scope notes for each one.' },
  { q: 'Are budgets, rates or availability verified?', a: 'No. They have not been researched. Confirm current team, availability and pricing directly with each agency.' },
  { q: 'How do I suggest a correction?', a: `Email <a href="mailto:${site.contactEmail}?subject=${encodeURIComponent('Correction: ' + industry.h1)}">${site.contactEmail}</a>. Corrections are reviewed before anything changes.` },
];

const jsonLd = [{
  '@type': 'CollectionPage',
  name: industry.h1,
  description: industry.metaDescription,
  url: absolute(industry.route),
  dateModified: site.lastReviewed,
  publisher: { '@type': 'Organization', name: site.publisher.name, url: site.siteUrl },
  mainEntity: {
    '@type': 'ItemList',
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    numberOfItems: industry.placements.length,
    itemListElement: industry.placements.map((p) => {
      const a = getAgency(p.agency_id)!;
      return { '@type': 'ListItem', position: p.position, name: a.name, url: absolute(agencyUrl(a)) };
    }),
  },
}];
---

<BaseLayout title={industry.title} description={industry.metaDescription} jsonLd={jsonLd}>
  <header class="page-header">
    <div class="container">
      <Breadcrumbs items={[{ name: 'Browse niches', href: '/agencies/' }, { name: industry.name, href: industry.route }]} />
      <p class="eyebrow">{industry.label} · {industry.placements.length} agencies</p>
      <h1>{industry.h1}</h1>
      <p class="lead">{industry.intro}</p>
      <ul class="tag-list" aria-label="Contexts covered">{industry.contexts.map((c) => <li class="tag">{c}</li>)}</ul>
      <AuthorReviewLine />
    </div>
  </header>

  <section class="section">
    <div class="container">
      <div class="notice prose-width">
        <p><strong>How to read this list:</strong> {site.disclosure} <strong>Selection emphasis:</strong> {industry.selection_emphasis}</p>
      </div>

      <h2 class="mt">Quick comparison</h2>
      <ComparisonTable industry={industry} />
      {industry.rationaleNote && <p class="prose-width muted note">{industry.rationaleNote}</p>}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Agency assessments</h2>
        <p>In the same order as the table. Each entry states the documented project, the agency's role, the work stage and what to confirm before hiring.</p>
      </div>
      <div class="assessments">
        {industry.placements.map((p) => <AgencyAssessment industry={industry} placement={p} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container two-col">
      <div>
        <h2>{industry.name} agency selection checklist</h2>
        <ul class="checklist">{industry.checklist.map((c) => <li>{c}</li>)}</ul>
      </div>
      <aside>
        <h2 class="h3">Hiring resources</h2>
        <ul class="plain">{guides.map((g) => <li><a href={`/guides/${g.slug}/`}>{g.title}</a></li>)}</ul>
        {related.length > 0 && (
          <>
            <h2 class="h3">Related niches</h2>
            <ul class="plain">{related.map((r) => <li><a href={r.route}>{r.h1}</a></li>)}</ul>
          </>
        )}
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Sources</h2>
      <p class="muted prose-width">These are agency-published pages, accessed during research. Accessing a source is not independent verification of outcomes. Found an error? <a href="/contact/">Send a correction</a>.</p>
      <ol class="sources">
        {sources.map((s) => (
          <li id={s.id}><span class="sid">{s.id}</span> <a href={s.url} rel="noopener" target="_blank">{s.label}</a>. {s.supported_context} <span class="muted">Note: {s.qualification} Accessed {s.accessed_date}.</span></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>FAQs</h2>
      <FAQ items={faqs} />
    </div>
  </section>
</BaseLayout>

<style>
  .mt { margin-top: 2rem; }
  .note { margin-top: 1rem; font-size: 0.95rem; }
  .assessments { display: grid; gap: 1rem; }
  .two-col { display: grid; grid-template-columns: 2fr 1fr; gap: 2.5rem; }
  .h3 { font-family: var(--font-sans); font-size: 1.1rem; margin-top: 0.25rem; }
  .checklist { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.6rem; }
  .checklist li { background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius-sm); padding: 0.75rem 1rem 0.75rem 2.6rem; position: relative; }
  .checklist li::before { content: ''; position: absolute; left: 1rem; top: 1.05rem; width: 0.9rem; height: 0.9rem; border: 2px solid var(--c-border-strong); border-radius: 3px; }
  .plain { list-style: none; padding: 0; margin: 0 0 1.5rem; }
  .plain li { margin-bottom: 0.4rem; }
  .sources { padding-left: 0; list-style: none; display: grid; gap: 0.6rem; font-size: 0.93rem; }
  .sid { display: inline-block; min-width: 2.6rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  @media (max-width: 820px) { .two-col { grid-template-columns: 1fr; } }
</style>
