---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox from '../components/SearchBox.astro';
import { getIndustries } from '../lib/data';
const industries = getIndustries();
---

<BaseLayout title="Page not found" description="The page you were looking for doesn't exist.">
  <section class="nf">
    <div class="container inner">
      <p class="code">404</p>
      <h1>We couldn't find that page</h1>
      <p class="lead">It may have moved. Search for an industry or agency instead.</p>
      <SearchBox id="nf-search" />
      <ul class="tag-list links">{industries.map((i) => <li><a class="tag" href={i.route}>{i.name}</a></li>)}</ul>
      <p><a class="btn btn-dark" href="/">Back to homepage</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .nf { padding-block: clamp(4rem, 10vw, 7rem); background: radial-gradient(600px 300px at 50% 0%, rgb(99 102 241 / 0.12), transparent 70%); }
  .inner { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .code { font-size: clamp(4rem, 12vw, 7rem); font-weight: 800; letter-spacing: -0.05em; line-height: 1; margin: 0 0 0.5rem; background: linear-gradient(90deg, #4f46e5, #7c3aed); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .lead { margin-bottom: 1.75rem; }
  .links { justify-content: center; margin: 1.5rem 0; }
  .links a { text-decoration: none; }
</style>
