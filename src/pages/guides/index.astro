---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { guides, absolute } from '../../lib/data';
const jsonLd = [{
  '@type': 'CollectionPage', name: 'UX agency hiring guides', url: absolute('/guides/'),
  mainEntity: { '@type': 'ItemList', itemListElement: guides.map((g, i) => ({ '@type': 'ListItem', position: i + 1, name: g.title, url: absolute(`/guides/${g.slug}/`) })) },
}];
---

<BaseLayout title="UX Agency Hiring Guides" description="Practical, copyable worksheets for hiring a UX design agency: brief template, proposal comparison, portfolio checklist and pricing models." jsonLd={jsonLd}>
  <header class="page-header">
    <div class="container">
      <Breadcrumbs items={[{ name: 'Hiring guides', href: '/guides/' }]} />
      <h1>Hiring guides</h1>
      <p class="lead">Practical resources for briefing, evaluating and comparing UX agencies. Copy or print any worksheet. No email required.</p>
    </div>
  </header>
  <div class="container section">
    <div class="grid grid-2">
      {guides.map((g) => (
        <article class:list={['card', { featured: g.featured }]}>
          {g.featured && <p class="eyebrow">Start here</p>}
          <h2><a href={`/guides/${g.slug}/`}>{g.title}</a></h2>
          <p class="muted">{g.description}</p>
          <a class="btn btn-secondary btn-small" href={`/guides/${g.slug}/`}>Open guide</a>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  h2 { font-size: 1.35rem; }
  h2 a { color: var(--c-text); text-decoration: none; }
  .featured { border-color: var(--c-accent); }
</style>
