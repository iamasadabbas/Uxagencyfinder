---
import BaseLayout from '../layouts/BaseLayout.astro';
import IndustryCard from '../components/IndustryCard.astro';
import QualificationBadge from '../components/QualificationBadge.astro';
import FAQ from '../components/FAQ.astro';
import AuthorReviewLine from '../components/AuthorReviewLine.astro';
import { site, getIndustries, getAgencies, getAgency, agencyUrl, absolute, guides } from '../lib/data';

const industries = getIndustries();
const agencies = getAgencies();
// Discovery preview: the first-listed agency from each published industry list (no cross-niche ranking).
const examples = industries.map((ind) => ({ ind, p: ind.placements[0], a: getAgency(ind.placements[0].agency_id)! }));

const faqs = [
  { q: 'What counts as industry experience?', a: 'A named project in that industry, with a public account of what the agency actually did. Visual style, generic "SaaS experience", a client logo with no scope, or a marketing website for a company in the industry do not count on their own.' },
  { q: 'How are positions chosen?', a: 'Each industry has its own editorial order, based on the relevance of the documented work and the published criteria for that list. Positions are not ratings, review scores or measured market rankings. See <a href="/methodology/">How we select</a>.' },
  { q: 'Do you verify budgets, rates or availability?', a: 'No. We have not researched current budgets, hourly rates, office locations or availability. Confirm these directly with each agency.' },
  { q: 'How do I suggest an agency or report a correction?', a: 'Email us through the <a href="/contact/">contact page</a>. Suggestions and corrections are reviewed and are never published automatically.' },
];

const jsonLd = [
  { '@type': 'Organization', name: site.publisher.name, url: site.siteUrl, description: site.publisher.description },
  { '@type': 'WebSite', name: site.name, url: site.siteUrl },
  {
    '@type': 'CollectionPage', name: 'Best UX Design Agencies by Industry', url: absolute('/'),
    mainEntity: { '@type': 'ItemList', itemListElement: industries.map((i, n) => ({ '@type': 'ListItem', position: n + 1, name: i.h1, url: absolute(i.route) })) },
  },
];
---

<BaseLayout
  fullTitle="Best UX Design Agencies by Industry | UX Agency Finder"
  title="Home"
  description="Find UX design agencies with documented work in your industry. Compare named projects and agency contributions across healthcare, fintech, ecommerce, logistics, real estate, education, robotics and AI."
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">Editorial agency selection · {industries.length} niches · {agencies.length} agencies</p>
      <h1>Find the best UX agencies for your industry</h1>
      <p class="lead">Explore UX design agencies with relevant experience in your market. Compare industry projects, see what each team actually contributed, and find partners to contact for your product.</p>
      <div class="cta">
        <a class="btn btn-primary" href="#industries">Browse agencies by industry</a>
        <a class="btn btn-secondary" href="/directory/">Explore the agency directory</a>
      </div>
      <AuthorReviewLine />
      <p class="small muted disclosure">{site.disclosure}</p>
    </div>
  </section>

  <section class="section" id="industries">
    <div class="container">
      <div class="section-head">
        <h2>Explore agencies in your industry</h2>
        <p>Each niche has its own list, criteria and order. An agency appears in a niche only when public evidence supports it.</p>
      </div>
      <div class="grid grid-4">
        {industries.map((i) => <IndustryCard industry={i} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Agencies with relevant industry work</h2>
        <p>A preview of the first-listed agency in each niche. This is not a cross-industry ranking. The full order and reasoning are on each industry page.</p>
      </div>
      <div class="grid grid-2">
        {examples.map(({ ind, p, a }) => (
          <article class="card example">
            <p class="eyebrow"><a href={ind.route}>{ind.name}</a></p>
            <h3><a href={agencyUrl(a)}>{a.name}</a></h3>
            <p class="small"><strong>Project:</strong> {p.project}</p>
            <p class="small muted">{p.contribution}</p>
            <QualificationBadge label={p.qualification_label} />
            <p class="small links"><a href={`${ind.route}#${a.slug}`}>Read assessment</a> · <a href={agencyUrl(a)}>Profile</a></p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <h2>Relevant industry work comes first</h2>
        <p>We look for named projects in the industry, a clear account of the agency's contribution, and evidence that shows which buyers the team may suit. Each list has its own criteria, source notes and questions to confirm before hiring.</p>
        <p><a href="/methodology/">Read our methodology</a> · <a href="/editorial-policy/">Editorial policy</a></p>
      </div>
      <ol class="steps">
        <li><strong>Choose an industry</strong><span>Start from your actual market context.</span></li>
        <li><strong>Compare the editorial list</strong><span>Named projects, contribution and scope limits.</span></li>
        <li><strong>Inspect the evidence</strong><span>Every placement links to the agency's own source.</span></li>
        <li><strong>Contact agencies directly</strong><span>We don't forward your details or take referral fees.</span></li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Hiring resources</h2>
        <p>Practical worksheets you can copy or print. No email required.</p>
      </div>
      <div class="grid grid-4">
        {guides.map((g) => (
          <article class:list={['card', 'guide', { featured: g.featured }]}>
            <h3><a href={`/guides/${g.slug}/`}>{g.title}</a></h3>
            <p class="small muted">{g.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Frequently asked questions</h2>
      <FAQ items={faqs} />
    </div>
  </section>
</BaseLayout>

<style>
  .hero { background: var(--c-surface); border-bottom: 1px solid var(--c-border); }
  .hero-inner { padding-block: clamp(2.5rem, 7vw, 4.5rem); max-width: 860px; margin-left: max(1.25rem, calc((100% - var(--w-content)) / 2)); }
  .lead { font-size: 1.2rem; color: var(--c-muted); max-width: 680px; }
  .cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 1.5rem 0 0.5rem; }
  .disclosure { margin-top: 1rem; max-width: 680px; }
  .example h3 { margin: 0 0 0.4rem; }
  .example h3 a { color: var(--c-text); text-decoration: none; }
  .example .eyebrow a { color: var(--c-muted); text-decoration: none; }
  .example .links { margin: 0.75rem 0 0; }
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; align-items: start; }
  .steps { list-style: none; counter-reset: s; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
  .steps li { counter-increment: s; display: grid; grid-template-columns: 2.25rem 1fr; column-gap: 0.75rem; background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius); padding: 0.85rem 1rem; }
  .steps li::before { content: counter(s); grid-row: span 2; display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%; background: var(--c-accent-soft); color: var(--c-accent); font-weight: 700; }
  .steps span { color: var(--c-muted); font-size: 0.95rem; }
  .guide h3 { font-size: 1.1rem; }
  .guide h3 a { color: var(--c-text); }
  .guide.featured { border-color: var(--c-accent); }
  @media (max-width: 820px) { .split { grid-template-columns: 1fr; } }
</style>
