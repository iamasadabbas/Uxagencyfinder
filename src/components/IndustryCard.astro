---
import type { Industry } from '../lib/data';
interface Props { industry: Industry }
const { industry } = Astro.props;
---

<article class="card industry-card">
  <h3><a href={industry.route} class="stretched">{industry.name}</a></h3>
  <p class="muted small count">{industry.placements.length} agencies with relevant work</p>
  <ul class="tag-list" aria-label={`${industry.name} contexts`}>
    {industry.contexts.slice(0, 4).map((c) => <li class="tag">{c}</li>)}
  </ul>
  <span class="go" aria-hidden="true">View list →</span>
</article>

<style>
  .industry-card { position: relative; display: flex; flex-direction: column; gap: 0.5rem; transition: border-color 0.15s, transform 0.15s; }
  .industry-card:hover { border-color: var(--c-accent); transform: translateY(-2px); }
  .industry-card:focus-within { border-color: var(--c-accent); }
  h3 { margin: 0; font-family: var(--font-serif); font-size: 1.35rem; }
  h3 a { color: var(--c-text); text-decoration: none; }
  .stretched::after { content: ''; position: absolute; inset: 0; border-radius: var(--radius); }
  .count { margin: 0; }
  .go { margin-top: auto; padding-top: 0.6rem; font-weight: 600; color: var(--c-accent); font-size: 0.95rem; }
</style>
