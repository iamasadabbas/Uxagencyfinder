---
// Umami Cloud analytics (free, cookieless). Loads only when site.json -> analytics.umamiWebsiteId is set,
// and only counts visits on the production domains listed in analytics.domains.
// Events: any element with data-track="event_name" (+ data-agency / data-industry / data-source) is sent on click.
// Code can also call window.uafTrack('event_name', { key: 'value' }).
import { site } from '../lib/data';
const a = site.analytics;
const enabled = a.provider === 'umami' && !!a.umamiWebsiteId;
---

{enabled && <script is:inline defer src={a.umamiScriptUrl} data-website-id={a.umamiWebsiteId} data-domains={a.domains}></script>}
<script is:inline>
  window.uafTrack = function (name, props) {
    try {
      if (window.umami && typeof window.umami.track === 'function') window.umami.track(name, props || undefined);
    } catch (e) {}
  };
  document.addEventListener('click', function (e) {
    var el = e.target && e.target.closest ? e.target.closest('[data-track]') : null;
    if (!el) return;
    var props = {};
    if (el.dataset.agency) props.agency = el.dataset.agency;
    if (el.dataset.industry) props.industry = el.dataset.industry;
    if (el.dataset.source) props.source = el.dataset.source;
    window.uafTrack(el.dataset.track, Object.keys(props).length ? props : undefined);
  }, { capture: true });
</script>

