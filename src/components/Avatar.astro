---
import { monogram } from '../lib/visuals';
interface Props { name: string; size?: number }
const { name, size = 44 } = Astro.props;
const m = monogram(name);
---

<span class="avatar" style={`width:${size}px;height:${size}px;font-size:${Math.round(size * 0.36)}px;background:${m.gradient};border-radius:${Math.round(size * 0.28)}px`} aria-hidden="true">{m.initials}</span>
