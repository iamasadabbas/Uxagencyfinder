---
import { getIndustries, site } from '../lib/data';
const industries = getIndustries();
const year = new Date(site.lastReviewed).getUTCFullYear();
---

<footer class="site-footer">
  <div class="container cols">
    <div class="about">
      <p class="name">UX Agency Finder</p>
      <p class="muted small">{site.tagline} An editorial selection organised by industry. Positions are editorial order, not ratings.</p>
    </div>
    <nav aria-label="Niches">
      <p class="heading">Niches</p>
      <ul>{industries.map((i) => <li><a href={i.route}>{i.name}</a></li>)}</ul>
    </nav>
    <nav aria-label="Explore">
      <p class="heading">Explore</p>
      <ul>
        <li><a href="/directory/">Agency directory</a></li>
        <li><a href="/guides/">Hiring guides</a></li>
        <li><a href="/methodology/">How we select</a></li>
      </ul>
    </nav>
    <nav aria-label="Company">
      <p class="heading">Company</p>
      <ul>
        <li><a href="/about/">About</a></li>
        <li><a href="/editorial-policy/">Editorial policy</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/terms/">Terms</a></li>
      </ul>
    </nav>
  </div>
  <div class="container legal small muted">© {year} {site.publisher.name}. Agency names belong to their owners. Listing does not imply endorsement by the agency.</div>
</footer>

<style>
  .site-footer { margin-top: 3rem; border-top: 1px solid var(--c-border); background: var(--c-surface); padding-block: 2.5rem 1.5rem; }
  .cols { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 2rem; }
  .name { font-weight: 800; margin-bottom: 0.4rem; }
  .heading { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--c-muted); margin-bottom: 0.6rem; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { margin-bottom: 0.35rem; }
  a { color: var(--c-text); text-decoration: none; font-size: 0.95rem; }
  a:hover { color: var(--c-accent); text-decoration: underline; }
  .legal { border-top: 1px solid var(--c-border); margin-top: 2rem; padding-top: 1.25rem; }
  @media (max-width: 760px) { .cols { grid-template-columns: 1fr 1fr; } .about { grid-column: 1 / -1; } }
</style>
