---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---

<div class="faq">
  {items.map((it) => (
    <details>
      <summary>{it.q}</summary>
      <p set:html={it.a} />
    </details>
  ))}
</div>

<style>
  .faq { max-width: var(--w-prose); border-top: 1px solid var(--c-border); }
  details { border-bottom: 1px solid var(--c-border); padding: 0.25rem 0; }
  summary { cursor: pointer; font-weight: 600; padding: 0.85rem 2rem 0.85rem 0; list-style: none; position: relative; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 0.25rem; top: 0.7rem; font-size: 1.3rem; color: var(--c-muted); }
  details[open] summary::after { content: '−'; }
  p { color: var(--c-muted); margin: 0 0 1rem; }
</style>
