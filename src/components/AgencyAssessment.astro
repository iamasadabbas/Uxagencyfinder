---
import type { Industry, Placement } from '../lib/data';
import { getAgency, getSource, agencyUrl } from '../lib/data';
import QualificationBadge from './QualificationBadge.astro';

interface Props { industry: Industry; placement: Placement }
const { industry, placement: p } = Astro.props;
const a = getAgency(p.agency_id)!;
const sources = p.source_ids.map((id) => getSource(id)!).filter(Boolean);
---

<article class="assessment card" id={a.slug} aria-labelledby={`h-${a.slug}`}>
  <header>
    <span class="pos" aria-hidden="true">{p.position}</span>
    <div>
      <h3 id={`h-${a.slug}`}><span class="visually-hidden">Position {p.position}: </span>{a.name}</h3>
      <p class="muted small sub">{p.subfield} · {p.project}</p>
    </div>
  </header>

  {p.qualification_label && <p><QualificationBadge label={p.qualification_label} /></p>}

  <dl class="facts">
    <div><dt>Why it's on the {industry.name} list</dt><dd>{p.fit_and_scope}</dd></div>
    <div><dt>Agency contribution</dt><dd>{p.contribution}</dd></div>
    <div><dt>Work stage</dt><dd>{p.work_stage}</dd></div>
    <div><dt>Evidence</dt>
      <dd>
        {sources.length === 0 ? 'No public source recorded.' : (
          <ul class="src">
            {sources.map((s) => (
              <li><a href={s.url} rel="noopener" target="_blank">{s.label}<span class="visually-hidden"> (opens agency website)</span></a> <span class="muted small">({s.id}) Note: {s.qualification}</span></li>
            ))}
          </ul>
        )}
      </dd>
    </div>
  </dl>

  <div class="actions">
    <a class="btn btn-secondary btn-small" href={agencyUrl(a)}>Full profile</a>
    <a class="btn btn-secondary btn-small" href={a.official_website} rel="noopener" target="_blank">Visit {a.name} ↗</a>
  </div>
</article>

<style>
  .assessment { scroll-margin-top: 5rem; }
  header { display: flex; gap: 0.85rem; align-items: flex-start; margin-bottom: 0.75rem; }
  h3 { margin: 0; font-size: 1.3rem; }
  .sub { margin: 0.15rem 0 0; }
  .facts { margin: 0; display: grid; gap: 0.75rem; }
  dt { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--c-muted); }
  dd { margin: 0.15rem 0 0; }
  .src { margin: 0; padding-left: 1.1rem; }
  .src li { margin-bottom: 0.3rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }
</style>
