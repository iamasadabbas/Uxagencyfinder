---
import type { Industry, Placement } from '../lib/data';
import { getAgency, getSource, agencyUrl } from '../lib/data';
import QualificationBadge from './QualificationBadge.astro';
import Avatar from './Avatar.astro';
import Icon from './Icon.astro';

interface Props { industry: Industry; placement: Placement }
const { industry, placement: p } = Astro.props;
const a = getAgency(p.agency_id)!;
const sources = p.source_ids.map((id) => getSource(id)!).filter(Boolean);
---

<article class="assessment" id={a.slug} aria-labelledby={`h-${a.slug}`}>
  <header>
    <span class:list={['pos', 'big', { 'pos-1': p.position === 1 }]} aria-hidden="true">{p.position}</span>
    <Avatar name={a.name} size={52} />
    <div class="h">
      <h3 id={`h-${a.slug}`}><span class="visually-hidden">Position {p.position}: </span>{a.name}</h3>
      <p class="sub">{p.subfield}</p>
    </div>
    <div class="head-actions">
      <a class="btn btn-secondary btn-small" href={agencyUrl(a)}>Profile</a>
      <a class="btn btn-dark btn-small" href={a.official_website} rel="noopener" target="_blank" data-track="official_site_click" data-agency={a.id} data-industry={industry.id}>Website <Icon name="external" size={14} /><span class="visually-hidden"> (opens in new tab)</span></a>
    </div>
  </header>

  {p.qualification_label && <div class="qual"><QualificationBadge label={p.qualification_label} /></div>}

  <p class="fit">{p.fit_and_scope}</p>

  <div class="facts">
    <div class="fact"><span class="k">Named project</span><span class="v">{p.project}</span></div>
    <div class="fact"><span class="k">Work stage</span><span class="v">{p.work_stage}</span></div>
    <div class="fact wide"><span class="k">Agency contribution</span><span class="v">{p.contribution}</span></div>
  </div>

  {sources.length > 0 && (
    <div class="evidence">
      <span class="k"><Icon name="link" size={14} /> Evidence</span>
      <ul>
        {sources.map((s) => (
          <li>
            <a href={s.url} rel="noopener" target="_blank" data-track="evidence_click" data-agency={a.id} data-industry={industry.id} data-source={s.id}>{s.label}<span class="visually-hidden"> (opens agency website)</span></a>
            <span class="note">{s.qualification}</span>
          </li>
        ))}
      </ul>
    </div>
  )}

  <details class="confirm">
    <summary><Icon name="check" size={14} /> What to confirm before hiring</summary>
    <p>{a.limits_and_questions}</p>
  </details>
</article>

<style>
  .assessment { scroll-margin-top: 6rem; background: #fff; border: 1px solid var(--c-border); border-radius: var(--radius-lg); padding: 1.6rem; box-shadow: var(--shadow-xs); transition: box-shadow 0.2s, border-color 0.2s; }
  .assessment:target { border-color: var(--c-accent); box-shadow: 0 0 0 4px rgb(99 102 241 / 0.12); }
  header { display: flex; gap: 0.9rem; align-items: center; flex-wrap: wrap; }
  .pos.big { min-width: 2.4rem; height: 2.4rem; font-size: 1.05rem; border-radius: 12px; }
  .h { flex: 1; min-width: 160px; }
  h3 { margin: 0; font-size: 1.35rem; }
  .sub { margin: 0.1rem 0 0; color: var(--c-muted); font-size: 0.9rem; }
  .head-actions { display: flex; gap: 0.5rem; }
  .qual { margin-top: 1rem; }
  .fit { margin: 1.1rem 0 1.25rem; font-size: 1.02rem; color: var(--c-text-2); }
  .facts { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .fact { background: var(--c-bg-soft); border: 1px solid var(--c-border); border-radius: 12px; padding: 0.85rem 1rem; display: flex; flex-direction: column; gap: 0.2rem; }
  .fact.wide { grid-column: 1 / -1; }
  .k { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.07em; color: var(--c-muted); }
  .v { color: var(--c-text); font-size: 0.94rem; }
  .evidence { margin-top: 1.1rem; padding-top: 1rem; border-top: 1px dashed var(--c-border); }
  .evidence ul { list-style: none; margin: 0.5rem 0 0; padding: 0; display: grid; gap: 0.5rem; }
  .evidence li { display: flex; flex-direction: column; font-size: 0.9rem; }
  .evidence a { font-weight: 600; }
  .note { color: var(--c-muted); font-size: 0.84rem; }
  .confirm { margin-top: 1rem; border-top: 1px dashed var(--c-border); padding-top: 0.9rem; }
  .confirm summary { cursor: pointer; display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.88rem; font-weight: 600; color: var(--c-accent); list-style: none; }
  .confirm summary::-webkit-details-marker { display: none; }
  .confirm summary :global(svg) { color: var(--c-success); }
  .confirm p { margin: 0.6rem 0 0; font-size: 0.92rem; color: var(--c-text-2); }
  @media (max-width: 640px) { .facts { grid-template-columns: 1fr; } .head-actions { width: 100%; } }
</style>
